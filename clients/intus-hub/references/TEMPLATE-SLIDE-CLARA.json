{
  "template": "carrossel-twitter-style",
  "version": "clara",
  "format": {
    "aspect_ratio": "4:5",
    "resolution": "1080x1350px",
    "background_color": "#FFFFFF"
  },
  "zones": {
    "header": {
      "height": "80px",
      "position": "top",
      "note": "DEIXAR LIVRE — adicionar manualmente no Canva",
      "conteudo": "foto de perfil + @diego.spanevello + categoria"
    },
    "content": {
      "position": "below header",
      "height": "55% do frame",
      "margin_lateral": "44px",
      "margin_top": "24px",
      "blocks": [
        {
          "id": "pre-headline",
          "type": "text",
          "content": "Texto de contexto pequeno aqui,",
          "font_size": "28px",
          "font_style": "regular sans-serif",
          "font_color": "#666666",
          "margin_bottom": "8px"
        },
        {
          "id": "headline",
          "type": "text-mixed",
          "lines": [
            {
              "content": "PALAVRA COMUM",
              "font_size": "96px",
              "font_style": "ultra bold condensed, all caps",
              "font_color": "#1A1A1A"
            },
            {
              "content": "PALAVRA DESTAQUE.",
              "font_size": "96px",
              "font_style": "ultra bold condensed, all caps",
              "font_color": "#E8722A",
              "note": "troca de cor no acento laranja"
            }
          ],
          "margin_bottom": "20px"
        },
        {
          "id": "subtext",
          "type": "text-marked",
          "content": "Frase de apoio com destaque aqui,",
          "font_size": "30px",
          "font_style": "regular sans-serif",
          "font_color": "#1A1A1A",
          "marking": {
            "type": "underline",
            "color": "#E8722A",
            "thickness": "3px"
          },
          "margin_bottom": "12px"
        },
        {
          "id": "body",
          "type": "text",
          "content": "Texto complementar mais leve e explicativo.",
          "font_size": "26px",
          "font_style": "regular sans-serif",
          "font_color": "#666666"
        }
      ]
    },
    "image": {
      "position": "bottom half",
      "height": "38% do frame",
      "margin_lateral": "44px",
      "margin_top": "20px",
      "border_radius": "18px",
      "note": "screenshot, foto ou colagem — nunca full bleed"
    },
    "footer": {
      "height": "60px",
      "position": "bottom",
      "margin_lateral": "44px",
      "note": "SLIDES INTERNOS: só username. CAPA: username + arraste pra ler. CTA: username + botões Salve/Siga.",
      "left": {
        "content": "@diego.spanevello",
        "font_size": "20px",
        "font_style": "regular sans-serif",
        "font_color": "#AAAAAA"
      },
      "center": {
        "content": null,
        "note": "vazio nos slides internos — usar 'arraste pra ler' + seta APENAS na capa"
      },
      "right": {
        "note": "vazio nos slides internos — usar botões Salve/Siga APENAS no CTA",
        "buttons_cta_only": [
          {
            "label": "Salve",
            "style": "pill",
            "background": "#F0F0F0",
            "font_color": "#1A1A1A"
          },
          {
            "label": "Siga",
            "style": "pill",
            "background": "#F0F0F0",
            "font_color": "#1A1A1A"
          }
        ]
      }
    }
  },
  "markings_available": {
    "color_swap": {
      "accent_color": "#E8722A",
      "usage": "palavra-chave isolada na headline"
    },
    "underline": {
      "color": "#E8722A",
      "thickness": "3px",
      "usage": "frase de apoio nivel 2"
    },
    "circle_handdrawn": {
      "color": "#E8722A",
      "style": "irregular, sketch",
      "usage": "numero ou dado de impacto"
    },
    "pill_badge": {
      "border_radius": "999px",
      "padding": "6px 16px",
      "colors": ["#2ECC71", "#E8722A", "#1A1A1A"],
      "usage": "label ou tag inline no texto"
    },
    "italic_underline": {
      "style": "italic + underline laranja",
      "usage": "titulos, nomes, referencias"
    }
  },
  "negative_rules": [
    "sem travessao",
    "sem linhas divisorias entre secoes",
    "maximo 3 tamanhos de fonte por slide",
    "maximo 1 ideia central por slide",
    "imagem nunca sem border radius",
    "header sempre livre para Canva"
  ]
}
